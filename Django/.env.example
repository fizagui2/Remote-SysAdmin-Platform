# Copy this file to .env and fill in real values. .env is gitignored;
# this template is not, so it's safe to commit.

# Postgres connection string (Supabase). Get it from a teammate or from
# Project Settings -> Database -> Connection string -> URI in the
# Supabase dashboard. Leave it unset / delete the line to fall back to
# local SQLite (db.sqlite3) for solo development.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
