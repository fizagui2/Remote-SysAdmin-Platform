# Copy this file to .env in this same directory, then fill it in.
# .env is gitignored. Never commit real credentials.

# Generate your own. Do not reuse a teammate's.
#   venv/Scripts/python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='replace-me'

# False for anything deployed.
DJANGO_DEBUG=True

# Comma-separated. '*' is for local development only.
# Set real hostnames before deploying.
DJANGO_ALLOWED_HOSTS=*

# Supabase Postgres. Use the SESSION POOLER string from the dashboard:
#   Project Settings -> Database -> Connection string -> Session pooler
#
# Do NOT use the direct connection (db.<ref>.supabase.co:5432). On the free
# plan it is IPv6-only, and it will hang and then time out on the IPv4-only
# networks we are all on. The pooler host looks like:
#   postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Leave empty to fall back to local SQLite.
DATABASE_URL=
