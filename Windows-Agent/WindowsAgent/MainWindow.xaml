<Window x:Class="WindowsAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote SysAdmin Agent"
        Height="640" Width="560" MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Remote SysAdmin Agent" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock x:Name="HostnameText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Starting..." Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ENROLLMENT CARD -->
        <Border x:Name="EnrollmentCard" Grid.Row="1"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Enroll this device" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12">
                    Go to the <Run FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}">Add Device</Run> page on your dashboard, log in, and generate a code. Then enter it below.
                </TextBlock>
                <TextBox x:Name="CodeInput" Style="{StaticResource CodeTextBox}" MaxLength="9"
                         CharacterCasing="Upper" KeyDown="CodeInput_KeyDown"/>
                <TextBlock x:Name="EnrollmentError" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button x:Name="SubmitCodeButton" Content="Enroll device" Style="{StaticResource AccentButton}"
                        Margin="0,14,0,0" Click="SubmitCodeButton_Click"/>
            </StackPanel>
        </Border>

        <!-- RECENT ACTIONS -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="4,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RECENT ACTIONS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="ClearActionsButton" Content="Clear" Style="{StaticResource LinkButton}"
                            Click="ClearActionsButton_Click"/>
                </Grid>
                <TextBlock x:Name="NoActionsText" Text="Nothing done on this PC yet."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontStyle="Italic" Margin="4,0,0,4"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ActionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,5">
                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}"
                                               FontWeight="Bold" FontSize="13" Width="20" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ACTIVITY LOG -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ACTIVITY" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="OK" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,10,0" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Heads up" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,10,0" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Error" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11" FontFamily="Consolas" Width="58" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
